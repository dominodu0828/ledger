# CockroachDB Cloud — from `ccloud cluster sql ledger`
COCKROACH_DSN=postgresql://USER:PASSWORD@HOST:26257/defaultdb?sslmode=verify-full

# AWS — Bedrock region must be one where you enabled model access
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Bedrock model IDs. Titan embeddings are a hard requirement — the whole
# pipeline is 1024-dim and the vector index is built for it.
#
# The reasoning model defaults to Nova Pro, which is what the deployed demo
# runs. Anthropic models on Bedrock are gated on the AWS account's registered
# country; where that gate passes, Claude is the better choice here and the
# switch is these two lines and nothing else:
#     BEDROCK_CHAT_MODEL=anthropic.claude-opus-5
#     CHAT_BACKEND=anthropic
BEDROCK_EMBED_MODEL=amazon.titan-embed-text-v2:0
BEDROCK_CHAT_MODEL=amazon.nova-pro-v1:0
CHAT_BACKEND=boto3

# Screening: 0.0 admits everything, 1.0 admits nothing. 0.5 is the default gate.
SCREEN_THRESHOLD=0.5
